{
  "name": "chuti",
  "version": "1.0.3",
  "description": "Offline-first Leave Management System for small organisations",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "Chuti Dev",
    "email": "dev@chuti.app"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev-lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start-lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron-dev": "electron .",
    "generate-ico": "node scripts/generate-ico.js",
    "build-exe": "npm run generate-ico && npm run build && electron-builder --win --x64",
    "build-exe-publish": "npm run generate-ico && npm run build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "app.chuti.leave-management",
    "compression": "store",
    "productName": "Chuti",
    "copyright": "Copyright © 2025 Chuti",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "!public/uploads/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*",
          "!uploads/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Chuti-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Chuti-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chuti"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.20.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sqlite3": "^3.1.11",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@electron/rebuild": {
      "node-abi": "^4.35.0"
    }
  }
}
